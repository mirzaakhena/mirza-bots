{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // cc-wrapper berjalan di Node (keputusan Task 0 -- lihat PROBE.md) tapi
    // di-test dengan bun test, jadi keduanya dibutuhkan.
    "types": ["bun", "node"]
  },
  "include": ["src", "test", "probe"]
}
